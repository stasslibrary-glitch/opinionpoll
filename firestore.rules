rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts and candidates are publicly readable (voters view them)
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /candidates/{candidateId} {
      allow read: if true;
      allow write: if request.auth != null;
      // Allow unauthenticated voters to increment the votes tally
      allow update: if true;
    }
    // Votes can be created by anyone; read by admins only
    match /votes/{voteId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
    // Admins collection: authenticated access only
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }
  }
}
